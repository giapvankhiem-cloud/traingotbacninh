# Server only: never prefix the Gemini key with VITE_.
# Put the real key in .env.local (ignored by Git) or the server secret environment.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# For a separate backend, list the exact frontend origins, comma separated.
AI_ALLOWED_ORIGINS="https://trai-ngot-bac-ninh.web.app,https://trai-ngot-bac-ninh.firebaseapp.com"
# Public backend origin for static Hosting; empty uses same-origin /api.
VITE_AI_API_URL=""

# Optional: base path for a static deployment. GitHub Pages uses
# /traingotbacninh/ by default; set e.g. / when hosting at a domain root.
VITE_BASE_PATH="/traingotbacninh/"

# Firebase public web configuration. Passwords are managed by Firebase Auth.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="trai-ngot-bac-ninh.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="trai-ngot-bac-ninh"
VITE_FIREBASE_APP_ID=""
# Canonical URL printed in QR labels. Set before printing physical labels.
VITE_PUBLIC_SITE_URL="https://trai-ngot-bac-ninh.web.app/"
# Local emulator only. Never enable for a deployed build.
VITE_USE_FIREBASE_EMULATORS="false"

# Public website: firebase uses Firebase AI Logic with App Check; api uses Express.
VITE_AI_PROVIDER="api"
VITE_AI_MODEL="gemini-3.5-flash-lite"
# Public reCAPTCHA Enterprise site key for the deployed web domains (not a Gemini key).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""
