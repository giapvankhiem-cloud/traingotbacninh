{
  "name": "trai-ngot-bac-ninh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); try{fs.unlinkSync('server.js')}catch{}\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/agriculture-rules.test.ts tests/domain.test.ts tests/certificates.test.ts tests/http.test.ts tests/seo.test.ts tests/ai-api.test.ts tests/ai-ui.test.tsx tests/firebase-ai.test.ts tests/media.test.ts tests/seasonal-notices.test.ts tests/role-landing.test.ts tests/expert-directory.test.tsx tests/expert-profile.test.ts",
    "test:rules": "node scripts/run-firebase-tests.mjs",
    "test:firebase": "node scripts/run-firebase-tests.mjs --full",
    "test:datasets": "node scripts/run-firebase-tests.mjs --datasets",
    "build:firebase": "node scripts/check-firebase-env.mjs && vite build --base=/ && tsx scripts/generate-seo.tsx",
    "deploy:firebase": "npm run build:firebase && firebase deploy --only hosting,firestore --project trai-ngot-bac-ninh",
    "emulators": "firebase emulators:start --project demo-traingot --only auth,firestore",
    "test:ai": "tsx --test tests/ai-api.test.ts tests/ai-ui.test.tsx tests/firebase-ai.test.ts",
    "test:ai:live": "tsx scripts/check-ai-live.ts"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
